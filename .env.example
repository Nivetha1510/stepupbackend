# Copy this file to .env and fill it in. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# ---- MySQL (the server you use in MySQL Workbench) ----
DB_NAME=stepup_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Hosting only: a full connection URL overrides the DB_* values above ----
# DATABASE_URL=mysql://user:password@host:3306/stepup_db
# DATABASE_URL=postgres://user:password@host:5432/stepup_db
DATABASE_SSL_REQUIRE=false

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Store settings
FREE_SHIPPING_THRESHOLD=999
STANDARD_SHIPPING_FEE=99

# Serve uploaded product images from Django
SERVE_MEDIA=true
# MEDIA_ROOT=/var/data/media

# ---- Razorpay online payment (https://dashboard.razorpay.com/app/keys; use Test Mode keys while developing) ----
# Leave empty to keep the no-money demo payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: set the same secret in Razorpay Dashboard > Webhooks (URL: <backend>/api/payments/webhook/, event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# ---- Password reset email ----
# EMAIL_MODE=console prints emails (including reset links) in the backend terminal: fine for development.
# EMAIL_MODE=smtp sends real email. Defaults to console when DJANGO_DEBUG=true, smtp otherwise.
EMAIL_MODE=console
# Link in the email points here: your frontend, e.g. http://localhost:5173 locally or https://your-site.com in production.
FRONTEND_URL=http://localhost:5173
# Reset links expire after this many seconds (default 3600 = 1 hour).
# PASSWORD_RESET_TIMEOUT=3600
# Sender shown to customers. Must be an address your email provider has verified for you.
DEFAULT_FROM_EMAIL=StepUp Support <your-verified-sender@example.com>
# SMTP settings (only used when EMAIL_MODE=smtp). See "Email setup" in the README.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# Limits per IP: forgot-password requests and reset submissions
# THROTTLE_PASSWORD_RESET=5/hour
# THROTTLE_PASSWORD_RESET_CONFIRM=10/hour

# ---- Direct UPI payment (shown at checkout only when UPI_ID is set) ----
# Your own UPI ID / VPA that customers pay, e.g. yourshop@okhdfcbank. Staff confirm payments in the Django admin.
UPI_ID=
UPI_PAYEE_NAME=StepUp.in
